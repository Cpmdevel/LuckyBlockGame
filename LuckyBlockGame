local function CreateToggle(label, toggleKey, colorOn, colorOff)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 38)
    btn.Text = label .. " ❌ OFF"
    btn.BackgroundColor3 = colorOff or Color3.fromRGB(80, 40, 40)
    btn.TextColor3 = Color3.fromRGB(255, 200, 200)
    btn.Font = Enum.Font.SourceSansBold
    btn.Parent = Scroll

    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        Toggles[toggleKey] = active
        if active then
            btn.Text = label .. " ✅ ON"
            btn.BackgroundColor3 = colorOn or Color3.fromRGB(40, 80, 40)
            btn.TextColor3 = Color3.fromRGB(200, 255, 200)
            -- Start loops
            if toggleKey == "AutoFarm" then
                task.spawn(AutoFarmLoop)
            elseif toggleKey == "AutoClickX2" then
                task.spawn(AutoClickLoop)
            elseif toggleKey == "RemoveWave" then
                task.spawn(RemoveWaveLoop)
            elseif toggleKey == "TripleFarm" then
                task.spawn(StartTripleFarm)
            elseif toggleKey == "Brainrot" then
                task.spawn(BrainrotLoop)
            end
        else
            btn.Text = label .. " ❌ OFF"
            btn.BackgroundColor3 = colorOff or Color3.fromRGB(80, 40, 40)
            btn.TextColor3 = Color3.fromRGB(255, 200, 200)
            -- Stop loops (they will exit automatically due to flag)
            if toggleKey == "TripleFarm" then
                FarmThreads = {}
            end
        end
    end)
    return btn
end

