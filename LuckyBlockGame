        if not (humanoid and root) then continue end

        local block = GetNearestBlock()
        if block then
            humanoid:MoveTo(block.Position)
            humanoid.MoveToFinished:Wait(0.3)
            if (root.Position - block.Position).Magnitude <= 8 then
                KickBlock(block)
            end
        end
        task.wait(0.15)
    end
end

local function StartTripleFarm()
    for i = 1, 3 do
        table.insert(FarmThreads, coroutine.create(TripleFarmThread))
    end
    for _, thread in ipairs(FarmThreads) do
        coroutine.resume(thread)
    end
end

local function RemoveWaveLoop()
    while Toggles.RemoveWave do
        task.wait(1)
        -- Reset wave values in workspace & player stats
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("IntValue") and obj.Name:lower():find("wave") then
                obj.Value = 0
            elseif obj:IsA("NumberValue") and obj.Name:lower():find("wave") then
                obj.Value = 0
            elseif obj:IsA("Folder") and obj.Name:lower():find("wave") then
                obj:Destroy()
            end
        end
        local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
        if leaderstats then
            local waveStat = leaderstats:FindFirstChild("Wave")
            if waveStat then waveStat.Value = 0 end
        end
        -- Also try killing all enemies (if any)
        for _, enemy in ipairs(Workspace:GetDescendants()) do
            if enemy:IsA("Model") and (enemy.Name:lower():find("zombie") or enemy.Name:lower():find("mob")) then
                if enemy:FindFirstChild("Humanoid") then
                    enemy.Humanoid.Health = 0
                end
            end
        end
    end
end

local function BrainrotLoop()
    while Toggles.Brainrot do
        task.wait(0.3)
        -- Random screen flashes
        for _, gui in ipairs(LocalPlayer.PlayerGui:GetChildren()) do
            if gui:IsA("ScreenGui") then
                gui.BackgroundColor3 = Color3.fromRGB(math.random(0,255), math.random(0,255), math.random(0,255))
                task.wait(0.05)
                gui.BackgroundColor3 = Color3.fromRGB(30,30,30)
            end
        end
        -- Random chat messages (if T key is held)
        if UserInputService:IsKeyDown(Enum.KeyCode.T) then
            local msgs = {"BRAINROT", "NO KEY", "TRIPLE FARM", "KICKED", "LUCKY BLOCK OP"}
            game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents") or
            game:GetService("Chat"):Chat(LocalPlayer.Character.Head, msgs[math.random(1,#msgs)])
        end
    end
end

-- ====================== INSTANT & PERFECT KICK ======================
local function InstantKick()
    if not Config.InstantKickEnabled then return end
    local block = GetNearestBlock()
    if block then
        -- Try all remote methods rapidly
        local remotes = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage
        for _, remote in ipairs(remotes:GetChildren()) do
            if remote:IsA("RemoteEvent") then
                remote:FireServer(block)
            end
        end
        fireclickdetector(block:FindFirstChildWhichIsA("ClickDetector"))
    end
end

local function PerfectKick()
    if not Config.PerfectKickEnabled then return end
    local block = GetNearestBlock()
    if block then
        -- Simulate perfect aim: move camera to block and kick
        local oldCamPos = Camera.CFrame
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, block.Position)
        task.wait(0.05)
        KickBlock(block)
        Camera.CFrame = oldCamPos
    end
end

